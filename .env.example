# Chiave API Gemini (https://aistudio.google.com/apikey)
# Lasciala vuota per usare solo il generatore locale di card.
# Non committare mai il file .env reale: e' gia' in .gitignore.
GEMINI_API_KEY=

# Modello usato per generare le card e spiegare le risposte.
GEMINI_MODEL=gemini-2.5-flash

# Segreto per le sessioni Flask. Cambialo in produzione.
SECRET_KEY=change-me

# Porta del server in locale. In produzione lo imposta la piattaforma.
PORT=5000

# Dimensione massima dei file caricati, in megabyte.
MAX_UPLOAD_MB=25